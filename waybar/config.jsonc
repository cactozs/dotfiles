{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 6,

    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],

    "modules-center": [
	      "niri/language",
        "clock#date", 
        "custom/time"
    ],

    "modules-right": [
        "backlight",
        "memory",
        "pulseaudio",
        "battery",
        "custom/power"
    ],

    "clock#date": {
        "format": "{:%a, %d %B}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 3600
    },

    "custom/time": {
        "exec": "$HOME/.config/waybar/scripts/waybar-time-weather.sh",
        "interval": 60,
        "return-type": "json",
        "format": "{}"
    },

    "niri/language": {
        "format": "󰌌 {}",
        "format-en": "EN",
        "format-ru": "RU",
    },

    "backlight": {
        "format": "󰃟 {percent}%"
    },

    "memory": {
        "format": "󰘚 {}%"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "wlogout"
    },

    "custom/theme": {
        "format": "󰔎",
        "tooltip": false,
        "on-click": "toggle-theme"
    }
}
